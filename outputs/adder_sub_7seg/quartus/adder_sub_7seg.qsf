set_location_assignment PIN_AC26 -to b[1]
set_location_assignment PIN_AD26 -to b[2]
set_location_assignment PIN_AB26 -to b[3]
set_location_assignment PIN_AC25 -to sub_mode
set_location_assignment PIN_G18 -to result[0]
set_location_assignment PIN_F22 -to result[1]
set_location_assignment PIN_E17 -to result[2]
set_location_assignment PIN_L26 -to result[3]
set_location_assignment PIN_L25 -to cout
set_location_assignment PIN_J22 -to overflow
set_location_assignment PIN_H22 -to zero
set_location_assignment PIN_M24 -to seg_sign[0]
set_location_assignment PIN_Y22 -to seg_sign[1]
set_location_assignment PIN_W21 -to seg_sign[2]
set_location_assignment PIN_W22 -to seg_sign[3]
